# -----------------------------------------------------------------------------
# IDE / editor machine-local state
#
# .vscode/ is intentionally NOT globally ignored:
# launch.json / tasks.json / settings.json may contain useful architecture,
# build and runtime information.
# -----------------------------------------------------------------------------

.idea/
.vs/

*.suo
*.user
*.userosscache
*.sln.docstates


# -----------------------------------------------------------------------------
# Environment files / secrets
#
# Defense in depth. Graphify itself also has sensitive-file filtering,
# but secrets should never depend on heuristics alone.
# -----------------------------------------------------------------------------

.env
.env.*

# Safe templates can remain useful for understanding required configuration.
!.env.example
!.env.sample
!.env.template
!.env.defaults

# Private keys / certificates containing private material
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# Credential stores / package registry credentials
.npmrc
.pypirc
.netrc
.git-credentials

credentials.json
service-account.json
service_account.json
service-account-*.json
service_account_*.json

# Common application-secret configuration
secrets.json
secrets.yaml
secrets.yml


# -----------------------------------------------------------------------------
# Database files / dumps / backups
#
# .sql is intentionally NOT ignored because schemas and migrations can be
# valuable graph inputs.
# -----------------------------------------------------------------------------

*.sqlite
*.sqlite3
*.db

*.dump
*.dmp
*.sql.gz
*.sql.bz2
*.sql.xz


# -----------------------------------------------------------------------------
# Generated documentation / site output
#
# Source documentation itself is intentionally kept.
# -----------------------------------------------------------------------------

site/.cache/
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/.docusaurus/
.docusaurus/


# -----------------------------------------------------------------------------
# Graphify
#
# IMPORTANT:
# Do NOT add "graphify-out/" here by default.
#
# Current Graphify uses graphify-out/converted/ for converted Office /
# Google Workspace sidecars. Graphify >= 0.9.60 contains special handling
# for its own converted output.
# -----------------------------------------------------------------------------