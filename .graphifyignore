# =============================================================================
# .graphifyignore
# Generic / language-agnostic Graphify ignore rules
# Target: Graphify >= 0.9.61
#
# Principles:
#   - Keep source code, tests, docs, schemas, CI/CD and infrastructure configs.
#   - Ignore dependencies, generated build output, caches and transient files.
#   - Avoid indexing secrets and machine-local state.
#   - Do NOT ignore docs/media globally: Graphify can extract them intentionally.
# =============================================================================


# -----------------------------------------------------------------------------
# Version-control internals
# -----------------------------------------------------------------------------

.git/
.hg/
.svn/


# -----------------------------------------------------------------------------
# Dependency / package-manager directories
# -----------------------------------------------------------------------------

# JavaScript / TypeScript
node_modules/
bower_components/

# PHP / Go / vendored dependencies
vendor/

# Python virtual environments / local packages
.venv/
venv/
env/
ENV/
__pypackages__/
.python-version

# Ruby
.bundle/

# Java / Gradle
.gradle/

# Swift
.build/

# Dart / Flutter
.dart_tool/
.pub-cache/

# Terraform / Terragrunt
.terraform/
.terragrunt-cache/


