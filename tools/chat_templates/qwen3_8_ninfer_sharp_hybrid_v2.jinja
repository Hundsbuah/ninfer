{#
SPDX-License-Identifier: Apache-2.0

Hybrid v2 template for Qwen3.8 + NInfer + OMP.

Technical base:
  Neroued/ninfer tools/chat_templates/qwen3_8.jinja
  master commit: beedffa052802580d6f456d4d36cf2f8307e0588

Sharp/Froggeric reference:
  peculiar-ragdoll/Qwen-Sharp-Chat-Templates v22.5.0
  commit: 85461fc118aaf25e7319c7ecf2481f944aac3a32

Design rule:
  NInfer remains authoritative for positional system/developer turns, XML tool
  serialization, tool-result history, Vision placeholders, reasoning history,
  final-assistant continuation, prompt-layout discovery, and prefix/cache
  boundaries.

  v2 adds only the Sharp/Froggeric changes that are useful in NInfer + OMP:
    - thinking-aware terseness steering, controlled by `terse` (default true);
    - NInfer-compatible effort aliases: minimal -> low, high/max -> xhigh;
    - thinking-aware XML tool instructions: with thinking off, tool calls are
      requested directly and no instruction refers to thinking;
    - `preserve_reasoning` as an optional compatibility alias for
      `preserve_thinking`; NInfer's canonical `preserve_thinking` wins if both
      are supplied.

  Deliberately NOT imported: JSON tool-call format, inline <|think_*|> controls,
  auto-disable-thinking-with-tools, tool-response/tool-argument truncation,
  runtime-specific alternate tool protocols, or Sharp's medium default effort.

  Unlike v1, `terse=false` disables only the terseness block; the v2 robustness
  fixes above remain active.
#}
{%- set image_count = namespace(value=0) %}
{%- set video_count = namespace(value=0) %}
{%- macro render_content(content, do_vision_count, is_system_content=false) %}
    {%- if content is string %}
        {{- content }}
    {%- elif content is iterable and content is not mapping %}
        {%- for item in content %}
            {%- if 'image' in item or 'image_url' in item or item.type == 'image' %}
                {%- if is_system_content %}
                    {{- raise_exception('System message cannot contain images.') }}
                {%- endif %}
                {%- if do_vision_count %}
                    {%- set image_count.value = image_count.value + 1 %}
                {%- endif %}
                {%- if add_vision_id %}
                    {{- 'Picture ' ~ image_count.value ~ ': ' }}
                {%- endif %}
                {{- '<|vision_start|><|image_pad|><|vision_end|>' }}
            {%- elif 'video' in item or item.type == 'video' %}
                {%- if is_system_content %}
                    {{- raise_exception('System message cannot contain videos.') }}
                {%- endif %}
                {%- if do_vision_count %}
                    {%- set video_count.value = video_count.value + 1 %}
                {%- endif %}
                {%- if add_vision_id %}
                    {{- 'Video ' ~ video_count.value ~ ': ' }}
                {%- endif %}
                {{- '<|vision_start|><|video_pad|><|vision_end|>' }}
            {%- elif 'text' in item %}
                {{- item.text }}
            {%- else %}
                {{- raise_exception('Unexpected item type in content.') }}
            {%- endif %}
        {%- endfor %}
    {%- elif content is none or content is undefined %}
        {{- '' }}
    {%- else %}
        {{- raise_exception('Unexpected content type.') }}
    {%- endif %}
{%- endmacro %}
{%- if not messages %}
    {{- raise_exception('No messages provided.') }}
{%- endif %}

{# NInfer is canonical. preserve_reasoning is accepted only as a compatibility alias. #}
{%- if preserve_thinking is defined and preserve_thinking is not none %}
    {%- set resolved_preserve_thinking = preserve_thinking %}
{%- elif preserve_reasoning is defined and preserve_reasoning is not none %}
    {%- if preserve_reasoning is true or preserve_reasoning is false %}
        {%- set resolved_preserve_thinking = preserve_reasoning %}
    {%- else %}
        {{- raise_exception('preserve_reasoning must be a boolean.') }}
    {%- endif %}
{%- else %}
    {%- set resolved_preserve_thinking = true %}
{%- endif %}

{# Keep NInfer's xhigh default, but normalize aliases already accepted by NInfer's API layer. #}
{%- set thinking_enabled = enable_thinking is undefined or enable_thinking is true %}
{%- set reasoning_instructions = '' %}
{%- if thinking_enabled %}
    {%- set requested_reasoning_effort = reasoning_effort|default('xhigh') %}
    {%- if requested_reasoning_effort == 'minimal' %}
        {%- set resolved_reasoning_effort = 'low' %}
    {%- elif requested_reasoning_effort in ('high', 'max') %}
        {%- set resolved_reasoning_effort = 'xhigh' %}
    {%- else %}
        {%- set resolved_reasoning_effort = requested_reasoning_effort %}
    {%- endif %}
    {%- if resolved_reasoning_effort not in ('xhigh', 'medium', 'low') %}
        {{- raise_exception('Unexpected reasoning effort ' ~ requested_reasoning_effort ~ '. Supported types are xhigh (default), high, max, medium, low, and minimal.') }}
    {%- endif %}
    {%- if resolved_reasoning_effort == 'xhigh' %}
        {%- set reasoning_instructions = 'Reasoning effort is set to xhigh. Please think carefully through the task, validate key assumptions, consider plausible alternatives, and prioritize correctness, consistency, and clarity in the final answer.' %}
    {%- elif resolved_reasoning_effort == 'low' %}
        {%- set reasoning_instructions = 'Reasoning effort is set to low. Keep your thinking brief and focused, moving directly to the conclusion without unnecessary elaboration.' %}
    {%- endif %}
{%- endif %}

{%- set terse_enabled = terse if terse is defined else true %}
{%- set terse_instructions = '' %}
{%- if terse_enabled %}
    {%- if thinking_enabled %}
        {%- set terse_lead = 'Answer directly, after thinking. Lead with the answer, then only what it needs to be correct and usable.' %}
    {%- else %}
        {%- set terse_lead = 'Answer directly and concisely. Give the answer with only what it needs to be correct and usable.' %}
    {%- endif %}
    {%- set terse_instructions = terse_lead
        + '\nNever: open with preamble or pleasantries; restate the question; add filler transitions; hedge with niceties; or repeat a point you have already made.'
        + '\nAlways: keep essential steps, caveats, uncertainties, and specifics — never drop correctness or a needed warning for brevity. Keep the final answer lean. Use the least structure that conveys it (plain prose when short; lists or code only when they earn their place). If genuinely uncertain, say so and explain why — never omit uncertainty for the sake of brevity.'
        + "\nIf a user request is genuinely ambiguous, ask a sharp question, don't guess." %}
{%- endif %}

{%- if tools and tools is iterable and tools is not mapping %}
    {{- '<|im_start|>system\n' }}
    {%- if reasoning_instructions %}
        {{- reasoning_instructions + '\n\n' }}
    {%- endif %}
    {{- "# Tools\n\nYou have access to the following functions:\n\n<tools>" }}
    {%- for tool in tools %}
        {{- "\n" }}
        {{- tool | tojson }}
    {%- endfor %}
    {{- "\n</tools>" }}
    {{- '\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n<tool_call>\n<function=example_function_name>\n<parameter=example_parameter_1>\nvalue_1\n</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n</tool_call>\n\n<IMPORTANT>\nReminder:\n' }}
    {%- if thinking_enabled %}
        {{- '- You can use the <think></think> block to plan your next tool call OR to synthesize data and formulate your final response to the user.\n- ALL explanation and reasoning MUST be placed strictly inside the <think></think> block.\n' }}
    {%- endif %}
    {{- '- Function calls MUST follow the specified format: an inner <function=...></function> block must be nested within <tool_call></tool_call> XML tags.\n- Required parameters MUST be specified.\n- If you choose to call a tool, you MUST output the <tool_call> block IMMEDIATELY' }}
    {%- if thinking_enabled %}
        {{- ' after thinking' }}
    {%- endif %}
    {{- ', with NO conversational text before it.\n- The <tool_call> and <function> tags MUST be at the very beginning of a new line, with NO spaces or indentation before them.\n- To call multiple functions, output a separate, completely closed <tool_call></tool_call> block for EACH function. Do NOT nest <tool_call> blocks.\n- If you have all necessary data, provide your final answer directly to the user without any tool call.\n</IMPORTANT>' }}
    {%- if messages[0].role in ('system', 'developer') %}
        {%- set content = render_content(messages[0].content, false, true)|trim %}
        {%- if content %}
            {{- '\n\n' + content }}
        {%- endif %}
    {%- endif %}
    {%- if terse_instructions %}
        {{- '\n\n' + terse_instructions }}
    {%- endif %}
    {{- '<|im_end|>\n' }}
{%- else %}
    {%- if messages[0].role in ('system', 'developer') %}
        {%- set content = render_content(messages[0].content, false, true)|trim %}
        {%- if content %}
            {%- if terse_instructions %}
                {{- '<|im_start|>system\n' + (reasoning_instructions + '\n\n' if reasoning_instructions else '') + content + '\n\n' + terse_instructions + '<|im_end|>\n' }}
            {%- else %}
                {{- '<|im_start|>system\n' + (reasoning_instructions + '\n\n' if reasoning_instructions else '') + content + '<|im_end|>\n' }}
            {%- endif %}
        {%- elif reasoning_instructions %}
            {%- if terse_instructions %}
                {{- '<|im_start|>system\n' + reasoning_instructions + '\n\n' + terse_instructions + '<|im_end|>\n' }}
            {%- else %}
                {{- '<|im_start|>system\n' + reasoning_instructions + '<|im_end|>\n' }}
            {%- endif %}
        {%- elif terse_instructions %}
            {{- '<|im_start|>system\n' + terse_instructions + '<|im_end|>\n' }}
        {%- endif %}
    {%- elif reasoning_instructions %}
        {%- if terse_instructions %}
            {{- '<|im_start|>system\n' + reasoning_instructions + '\n\n' + terse_instructions + '<|im_end|>\n' }}
        {%- else %}
            {{- '<|im_start|>system\n' + reasoning_instructions + '<|im_end|>\n' }}
        {%- endif %}
    {%- elif terse_instructions %}
        {{- '<|im_start|>system\n' + terse_instructions + '<|im_end|>\n' }}
    {%- endif %}
{%- endif %}

{%- set ns = namespace(multi_step_tool=true, last_query_index=messages|length - 1, last_tool_index=-1) %}
{%- for message in messages[::-1] %}
    {%- set index = (messages|length - 1) - loop.index0 %}
    {%- if message.role == "tool" and ns.last_tool_index < 0 %}
        {%- set ns.last_tool_index = index %}
    {%- endif %}
    {%- if ns.multi_step_tool and message.role == "user" %}
        {%- set content = render_content(message.content, false)|trim %}
        {%- if not(content.startswith('<tool_response>') and content.endswith('</tool_response>')) %}
            {%- set ns.multi_step_tool = false %}
            {%- set ns.last_query_index = index %}
        {%- endif %}
    {%- endif %}
{%- endfor %}
{%- if ns.multi_step_tool and ns.last_tool_index >= 0 %}
    {%- set ns.last_query_index = ns.last_tool_index %}
{%- elif ns.multi_step_tool %}
    {{- raise_exception('No user query found in messages.') }}
{%- endif %}

{%- for message in messages %}
    {%- set content = render_content(message.content, true, message.role in ("system", "developer"))|trim %}
    {%- if message.role in ("system", "developer") %}
        {%- if not loop.first %}
            {{- '<|im_start|>system\n' + content + '<|im_end|>\n' }}
        {%- endif %}
    {%- elif message.role == "user" %}
        {{- '<|im_start|>' + message.role + '\n' + content + '<|im_end|>' + '\n' }}
    {%- elif message.role == "assistant" %}
        {%- set continuing = continue_final_message|default(false) and loop.last %}
        {%- set reasoning_content = '' %}
        {%- if message.reasoning_content is string %}
            {%- set reasoning_content = message.reasoning_content %}
        {%- endif %}
        {%- set reasoning_content = reasoning_content|trim %}
        {%- if not continuing and (resolved_preserve_thinking or loop.index0 > ns.last_query_index) %}
            {{- '<|im_start|>' + message.role + '\n<think>\n' + reasoning_content + '\n</think>\n\n' + content }}
        {%- else %}
            {{- '<|im_start|>' + message.role + '\n' + content }}
        {%- endif %}
        {%- if message.tool_calls and message.tool_calls is iterable and message.tool_calls is not mapping %}
            {%- for tool_call in message.tool_calls %}
                {%- if tool_call.function is defined %}
                    {%- set tool_call = tool_call.function %}
                {%- endif %}
                {%- if loop.first %}
                    {%- if content|trim %}
                        {{- '\n\n<tool_call>\n<function=' + tool_call.name + '>\n' }}
                    {%- else %}
                        {{- '<tool_call>\n<function=' + tool_call.name + '>\n' }}
                    {%- endif %}
                {%- else %}
                    {{- '\n<tool_call>\n<function=' + tool_call.name + '>\n' }}
                {%- endif %}
                {%- if tool_call.arguments is defined and tool_call.arguments != '' %}
                    {%- for args_name, args_value in tool_call.arguments|items %}
                        {{- '<parameter=' + args_name + '>\n' }}
                        {%- set args_value = args_value | string if args_value is string else args_value | tojson | safe %}
                        {{- args_value }}
                        {{- '\n</parameter>\n' }}
                    {%- endfor %}
                {%- endif %}
                {{- '</function>\n</tool_call>' }}
            {%- endfor %}
        {%- endif %}
        {%- if not continuing %}
            {{- '<|im_end|>\n' }}
        {%- endif %}
    {%- elif message.role == "tool" %}
        {%- if loop.first or loop.previtem.role != "tool" %}
            {{- '<|im_start|>user' }}
        {%- endif %}
        {{- '\n<tool_response>\n' }}
        {{- content }}
        {{- '\n</tool_response>' }}
        {%- if not loop.last and loop.nextitem.role != "tool" %}
            {{- '<|im_end|>\n' }}
        {%- elif loop.last %}
            {{- '<|im_end|>\n' }}
        {%- endif %}
    {%- else %}
        {{- raise_exception('Unexpected message role.') }}
    {%- endif %}
{%- endfor %}
{%- if add_generation_prompt %}
    {{- '<|im_start|>assistant\n' }}
    {%- if thinking_enabled %}
        {{- '<think>\n' }}
    {%- else %}
        {{- '<think>\n\n</think>\n\n' }}
    {%- endif %}
{%- endif %}
